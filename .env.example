# Copy to .env.local and fill in real values (see README.md "Setup").
# .env.local is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
VITE_POWERSYNC_URL=https://<your-instance>.powersync.journeyapps.com

# Public (pk.*) Mapbox token, restricted by URL in the Mapbox dashboard.
# Used for both the map display and the Search Box API (restaurant lookup).
VITE_MAPBOX_TOKEN=pk.<your-mapbox-token>
