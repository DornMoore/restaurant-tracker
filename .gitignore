# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Real secrets only ever go in .env.local (gitignored via *.local above).
# Block plain .env too, in case one gets created again — only .env.example
# (the checked-in template with no real values) should ever be tracked.
.env
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
